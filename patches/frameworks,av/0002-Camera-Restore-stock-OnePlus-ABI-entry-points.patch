+// Legacy entry points used by the stock OnePlus extension. These accept live
+// framework state and delegate to current helpers; they do not replace the
+// current CaptureOutputStates/InFlightRequest layouts with stock definitions.
+void sendCaptureResult(CaptureOutputStates& states, CameraMetadata& pendingMetadata,
+        CaptureResultExtras& resultExtras, CameraMetadata& collectedPartialResult,
+        uint32_t frameNumber, bool reprocess, bool zslStillCapture, bool rotateAndCropAuto,
+        const std::set<std::string>& cameraIdsWithZoom,
+        const std::vector<PhysicalCaptureResultInfo>& physicalMetadatas) {
+    const ssize_t index = states.inflightMap.indexOfKey(frameNumber);
+    const bool useZoomRatio = index >= 0
+            ? states.inflightMap.valueAt(index).useZoomRatio
+            : pendingMetadata.find(ANDROID_CONTROL_ZOOM_RATIO).count != 0;
+    sendCaptureResult(states, pendingMetadata, resultExtras, collectedPartialResult,
+            frameNumber, reprocess, zslStillCapture, rotateAndCropAuto,
+            cameraIdsWithZoom, useZoomRatio, physicalMetadatas);
+}
+
+void returnOutputBuffers(bool useHalBufManager, sp<NotificationListener> listener,
+        const camera_stream_buffer_t* outputBuffers, size_t numBuffers,
+        nsecs_t timestamp, bool requested, nsecs_t requestTimeNs,
+        SessionStatsBuilder& sessionStatsBuilder, bool timestampIncreasing,
+        const std::unordered_map<int32_t, std::vector<uint64_t>>& outputSurfaces,
+        const CaptureResultExtras& resultExtras, ERROR_BUF_STRATEGY errorBufStrategy) {
+    SurfaceMap surfaces;
+    for (const auto& [streamId, ids] : outputSurfaces) {
+        surfaces[streamId].assign(ids.begin(), ids.end());
+    }
+    std::vector<BufferToReturn> buffers;
+    collectReturnableOutputBuffers(useHalBufManager, /*halBufferManagedStreams*/{}, listener,
+            outputBuffers, numBuffers, timestamp, /*readoutTimestamp*/0, requested,
+            requestTimeNs, sessionStatsBuilder, &buffers, timestampIncreasing,
+            surfaces, resultExtras, errorBufStrategy, TransformationMap{});
+    finishReturningOutputBuffers(buffers, listener, sessionStatsBuilder);
+}
+
+void removeInFlightRequestIfReadyLocked(CaptureOutputStates& states, int index) {
+    std::vector<BufferToReturn> buffers;
+    removeInFlightRequestIfReadyLocked(states, index, &buffers);
+    if (!buffers.empty()) {
+        // The legacy caller owns inflightLock. Preserve that contract on return,
+        // but do not deliver buffers through two-way Binder calls under the lock.
+        struct RelockOnExit {
+            std::mutex& lock;
+            explicit RelockOnExit(std::mutex& mutex) : lock(mutex) { lock.unlock(); }
+            ~RelockOnExit() { lock.lock(); }
+        } unlocked(states.inflightLock);
+        finishReturningOutputBuffers(buffers, states.listener, states.sessionStatsBuilder);
+    }
+}
+
 } // camera3
 } // namespace android
