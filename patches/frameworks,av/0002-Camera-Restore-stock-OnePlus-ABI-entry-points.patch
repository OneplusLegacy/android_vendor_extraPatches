 #include <dlfcn.h>
 #include <log/log.h>
 #include <cutils/properties.h>
+#include <binderthreadstate/CallerUtils.h>
+
 
 namespace android {
 
+// Legacy stock ABI. Use the same Binder/HwBinder caller selection as the
+// current AttributionAndPermissionUtils implementation; never use our own UID.
+class CameraThreadState {
+public:
+    static pid_t getCallingPid();
+    static uid_t getCallingUid();
+};
+
+pid_t CameraThreadState::getCallingPid() {
+    if (getCurrentServingCall() == BinderCallType::HWBINDER) {
+        return hardware::IPCThreadState::self()->getCallingPid();
+    }
+    return IPCThreadState::self()->getCallingPid();
+}
+
+uid_t CameraThreadState::getCallingUid() {
+    if (getCurrentServingCall() == BinderCallType::HWBINDER) {
+        return hardware::IPCThreadState::self()->getCallingUid();
+    }
+    return IPCThreadState::self()->getCallingUid();
+}
+
 void* CameraServiceExtFactory::sFunctionTable = nullptr;
 void* CameraServiceExtFactory::sExtObject = nullptr;
 int (*CameraServiceExtFactory::sOnTransactFunc)(void*, uint32_t, const Parcel&, Parcel*, uint32_t) = nullptr;
